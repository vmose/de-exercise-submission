# dbt
target/
dbt_packages/
logs/

# DuckDB database (rebuilt every run)
*.duckdb
*.duckdb.wal

# generated by DQ1 (validated copies of source files) and DQ1/DQ4 logs —
# these are outputs of a run, not inputs to commit; dq_logs/.gitkeep keeps
# the directory itself so a clean clone has somewhere for them to land
validated/
dq_logs/*.csv
!dq_logs/.gitkeep

# python
.venv/
__pycache__/
*.pyc

# dbt user-level config (invocation id etc., not project config)
.user.yml
